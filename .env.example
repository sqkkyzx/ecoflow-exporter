# Credentials are entered here only for compose.yaml.
# Prefer compose.secrets.yaml when using *_FILE instead.
ECOFLOW_ACCOUNT='YOUR_CN_PHONE_NUMBER'
ECOFLOW_PASSWORD='YOUR_ECOFLOW_APP_PASSWORD'
ECOFLOW_SN='YOUR_RIVER3_UPS_SN'

ECOFLOW_DEVICE_NAME=river3
ECOFLOW_API_HOST=api-cn.ecoflow.com
EXPORTER_PORT=9098

ECOFLOW_STALE_SECONDS=120
ECOFLOW_READ_COOLDOWN_SECONDS=30
ECOFLOW_RECONNECT_MIN_SECONDS=5
ECOFLOW_RECONNECT_MAX_SECONDS=300
ECOFLOW_AUTH_RETRY_SECONDS=300
LOG_LEVEL=INFO
